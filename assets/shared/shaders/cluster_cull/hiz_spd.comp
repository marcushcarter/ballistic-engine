#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_samplerless_texture_functions : require

layout(set = 0, binding = 0) uniform texture2D uTextures[];
layout(set = 0, binding = 1, r16f) uniform image2D uStorageImages[];   // r16f now

layout(buffer_reference, scalar) buffer Counter { uint value; };

layout(push_constant) uniform Push {
    Counter counter;
    ivec2 base_size;      // FULL depth size
    uint depth_index;
    uint mips;
    uint num_workgroups;
    uint _pad;
    uint mip_slot[16];
} pc;

layout(local_size_x = 256) in;

shared uint s_last;

void reduce_region(uint dst_mip, ivec2 dst_origin, ivec2 dst_dim) {
    uint src_slot = pc.mip_slot[dst_mip - 1u];
    uint dst_slot = pc.mip_slot[dst_mip];
    ivec2 src_sz = imageSize(uStorageImages[nonuniformEXT(src_slot)]);   // once
    ivec2 dst_sz = imageSize(uStorageImages[nonuniformEXT(dst_slot)]);   // once
    bool ox = (src_sz.x & 1) != 0, oy = (src_sz.y & 1) != 0;
    uint total = uint(dst_dim.x * dst_dim.y);
    for (uint i = gl_LocalInvocationIndex; i < total; i += 256u) {
        ivec2 dp = dst_origin + ivec2(int(i) % dst_dim.x, int(i) / dst_dim.x);
        if (dp.x >= dst_sz.x || dp.y >= dst_sz.y) continue;
        ivec2 s = dp * 2;
        #define LD(o) imageLoad(uStorageImages[nonuniformEXT(src_slot)], clamp(s + (o), ivec2(0), src_sz - 1)).r
        float m = min(min(LD(ivec2(0,0)), LD(ivec2(1,0))), min(LD(ivec2(0,1)), LD(ivec2(1,1))));
        if (ox && dp.x == dst_sz.x - 1) m = min(m, min(LD(ivec2(2,0)), LD(ivec2(2,1))));
        if (oy && dp.y == dst_sz.y - 1) m = min(m, min(LD(ivec2(0,2)), LD(ivec2(1,2))));
        if (ox && oy && dp.x == dst_sz.x - 1 && dp.y == dst_sz.y - 1) m = min(m, LD(ivec2(2,2)));
        #undef LD
        imageStore(uStorageImages[nonuniformEXT(dst_slot)], dp, vec4(m));
    }
}

void main() {
    ivec2 tile0 = ivec2(gl_WorkGroupID.xy) * 64;

    uint m0_slot = pc.mip_slot[0];
    ivec2 m0 = imageSize(uStorageImages[nonuniformEXT(m0_slot)]);
    for (uint i = gl_LocalInvocationIndex; i < 64u * 64u; i += 256u) {
        ivec2 dp = tile0 + ivec2(int(i) & 63, int(i) >> 6);
        if (dp.x >= m0.x || dp.y >= m0.y) continue;
        ivec2 s = dp * 2;   // full-res depth coord
        #define LDD(o) texelFetch(uTextures[nonuniformEXT(pc.depth_index)], clamp(s + (o), ivec2(0), pc.base_size - 1), 0).r
        float d = min(min(LDD(ivec2(0,0)), LDD(ivec2(1,0))), min(LDD(ivec2(0,1)), LDD(ivec2(1,1))));
        #undef LDD
        imageStore(uStorageImages[nonuniformEXT(m0_slot)], dp, vec4(d));
    }
    memoryBarrierImage(); barrier();

    for (uint mm = 1u; mm <= 6u && mm < pc.mips; mm++) {
        reduce_region(mm, tile0 >> int(mm), ivec2(max(1, 64 >> int(mm))));
        memoryBarrierImage(); barrier();
    }

    if (pc.mips <= 7u) return;

    memoryBarrier(gl_ScopeDevice, gl_StorageSemanticsImage, gl_SemanticsRelease);
    if (gl_LocalInvocationIndex == 0u) {
        uint prev = atomicAdd(pc.counter.value, 1u, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsAcquireRelease);
        s_last = (prev == pc.num_workgroups - 1u) ? 1u : 0u;
    }
    barrier();
    if (s_last == 0u) return;

    memoryBarrier(gl_ScopeDevice, gl_StorageSemanticsImage, gl_SemanticsAcquire);
    for (uint mm = 7u; mm < pc.mips; mm++) {
        ivec2 dsz = imageSize(uStorageImages[nonuniformEXT(pc.mip_slot[mm])]);
        reduce_region(mm, ivec2(0), dsz);
        memoryBarrierImage(); barrier();
    }
}