#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "common/geometry.glsl"

layout(local_size_x = 64) in;

struct DrawIndexedIndirectCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};

layout(buffer_reference, scalar) readonly buffer VisibleClusterBuffer { uint count; uint data[]; };
layout(buffer_reference, scalar) readonly buffer ClusterRefsBuffer { uint count; uint _pad; uint64_t data[]; };
layout(buffer_reference, scalar) writeonly buffer DrawCmdBuffer { DrawIndexedIndirectCommand cmds[]; };

layout(push_constant) uniform Push {
    GeometryBuffer geometry;
    ClusterRefsBuffer cluster_refs;
    VisibleClusterBuffer visible_clusters;
    DrawCmdBuffer draw_cmds;
} pc;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= pc.visible_clusters.count) return;

    uint ref_idx = pc.visible_clusters.data[id];
    uint64_t ref = pc.cluster_refs.data[ref_idx];
    uint cluster_id = uint(ref & 0xffffffffUL);

    Cluster cluster = pc.geometry.clusters.clusters[cluster_id];

    DrawIndexedIndirectCommand cmd;
    cmd.index_count = cluster.index_count;
    cmd.instance_count = 1u;
    cmd.first_index = cluster.index_base;
    cmd.vertex_offset = 0;
    cmd.first_instance = 0u;
    pc.draw_cmds.cmds[id] = cmd;
}