#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 1) in;

layout(buffer_reference, scalar) readonly buffer VisibleInstanceBuffer { uint count; };
layout(buffer_reference, scalar) writeonly buffer IndirectDispatch { uint x; uint y; uint z; };
layout(buffer_reference, scalar) writeonly buffer ClusterRefsBuffer { uint count; };

layout(push_constant) uniform Push {
    VisibleInstanceBuffer visible_instances;
    IndirectDispatch expand_args;
    ClusterRefsBuffer cluster_refs;
} pc;

void main() {
    pc.expand_args.x = (pc.visible_instances.count + 63u) / 64u;
    pc.expand_args.y = 1u;
    pc.expand_args.z = 1u;

    pc.cluster_refs.count = 0u;
}