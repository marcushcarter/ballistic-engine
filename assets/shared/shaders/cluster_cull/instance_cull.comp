#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

#include "common/geometry.glsl"
#include "common/camera.glsl"

layout(local_size_x = 64) in;

struct Instance {
    uint mesh_id;
    uint transform_id;
    uint _pad0[2];
};

struct Transform {
    mat4 prev_mtx;
    mat4 curr_mtx;
};

layout(buffer_reference, scalar) readonly buffer InstanceBuffer { Instance data[]; };
layout(buffer_reference, scalar) readonly buffer TransformBuffer { Transform data[]; };
layout(buffer_reference, scalar) writeonly buffer VisibleInstanceBuffer { uint data[]; };

layout(push_constant) uniform Push {
    CameraBuffer camera;
    GeometryBuffer geometry;
    InstanceBuffer instances;
    TransformBuffer transforms;
    VisibleInstanceBuffer visible_instances;
    uint instance_count;
} pc;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= pc.instance_count) return;

    Instance instance = pc.instances.data[id];
    Mesh mesh = pc.geometry.meshes.data[instance.mesh_id];
    
    uint slot = atomicAdd(pc.visible_instances.data[0], 1u);
    pc.visible_instances.data[slot + 1] = id;
}