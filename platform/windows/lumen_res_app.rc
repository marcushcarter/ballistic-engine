#include "core/version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

1 RT_MANIFEST "platform/windows/lumen.manifest"

1 VERSIONINFO
FILEVERSION     LUMEN_VERSION_MAJOR,LUMEN_VERSION_MINOR,LUMEN_VERSION_PATCH,0
PRODUCTVERSION  LUMEN_VERSION_MAJOR,LUMEN_VERSION_MINOR,LUMEN_VERSION_PATCH,0
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",     "Lumen Games"
            VALUE "FileDescription", "Lumen App"
            VALUE "FileVersion",     LUMEN_VERSION_NUMBER
            VALUE "ProductVersion",  LUMEN_VERSION_FULL_BUILD
            VALUE "ProductName",     LUMEN_VERSION_NAME
            VALUE "Licence",         "MIT"
            VALUE "LegalCopyright",  "(c) 2026-present Marcus Carter"
            VALUE "Info",            "https://lumengames.ca"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END